# Application
APP_ENV=development
APP_NAME=ai-knowledge-structuring-agent
LOG_LEVEL=INFO

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend
BACKEND_CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/knowledge_agent
REDIS_URL=redis://redis:6379/0
CHROMA_HOST=chromadb
CHROMA_PORT=8000
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=documents
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_BYTES=26214400

# AI provider — set locally, never commit real secrets
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=
# auto keeps OpenAI on strict json_schema and switches OpenAI-compatible gateways
# (DeepSeek, Moonshot, local vLLM, ...) to function calling.
LLM_STRUCTURED_OUTPUT=auto

# Retrieval pipeline (defaults keep the stack runnable without a provider key)
EMBEDDING_PROVIDER=deterministic
EMBEDDING_DIMENSIONS=256
CHROMA_COLLECTION=document_chunks
CHUNK_MAX_CHARACTERS=900
CHUNK_OVERLAP_CHARACTERS=150
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.1
NODE_EVIDENCE_BOOST=0.15
MAX_QUESTION_CHARACTERS=1000

# OCR fallback for scanned PDFs (requires tesseract inside the backend image)
OCR_ENABLED=true
OCR_LANGUAGES=chi_sim+eng
OCR_DPI=300
OCR_FALLBACK_DPI=200
OCR_PSM=3
OCR_BINARIZE=false
OCR_BINARIZE_THRESHOLD=165
OCR_MIN_TEXT_CHARACTERS=12
OCR_MAX_PAGES=50

# Async job reliability
TASK_MAX_RETRIES=2
TASK_RETRY_BACKOFF_SECONDS=10
TASK_RETRY_BACKOFF_MAX_SECONDS=120
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
STALE_JOB_TIMEOUT_SECONDS=1800
REAPER_INTERVAL_SECONDS=300

# Postgres / MinIO local development credentials
POSTGRES_DB=knowledge_agent
POSTGRES_USER=app
POSTGRES_PASSWORD=app
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
